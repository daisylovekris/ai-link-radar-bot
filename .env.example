# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API key for /triage AI analysis (optional; only required for /triage)
OPENAI_API_KEY=

# OpenAI model used by /triage (optional; default gpt-5.6)
OPENAI_MODEL=gpt-5.6

# 保存链接的 Markdown 文件名（可选，默认 links.md）
LINKS_FILE=links.md

# 允许使用本机器人的 Telegram user id 列表，逗号分隔（规划中，当前尚未强制校验）
# ALLOWED_USER_IDS=123456789,987654321
